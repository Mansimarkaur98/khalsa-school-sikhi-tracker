# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection — matches the khalsa_school database, sikhi_tracker schema
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/khalsa_school

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# The MVP's single shared teacher login
APP_USERNAME=khalsastaff
# Generate a hash with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
APP_PASSWORD_HASH=changeme_generate_a_real_hash

# Cloudinary — sign up free at cloudinary.com, find this on your dashboard homepage
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=changeme_your_cloudinary_url

# Gmail SMTP — sends the signup account-activation email.
# Generate an App Password at myaccount.google.com/apppasswords (requires 2-Step Verification).
# Optional in dev: leave SMTP_USERNAME/SMTP_PASSWORD unset and activation links are logged
# to the backend console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=changeme_your_gmail_address
SMTP_PASSWORD=changeme_your_16_char_app_password
FRONTEND_URL=http://localhost:5173
